; rt73_winusb.inf — bindea WinUSB al Ralink RT73 para acceso USB crudo
; (libusb/rusb). Reversible: "pnputil /delete-driver oemXX.inf /uninstall"
; o restore_netr73.ps1. Lab-only. testsigning ON.
[Version]
Signature   = "$Windows NT$"
Class       = USB
ClassGuid   = {36fc9e60-c465-11cf-8056-444553540000}
Provider    = %ProviderName%
CatalogFile = rt73_winusb.cat
DriverVer   = 11/18/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard, NTamd64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_148F&PID_2573

; ********** Windows 10/11 WinUSB user-mode driver template (OSR style) **********
[USB_Install]
Include    = winusb.inf
Needs      = WINUSB.NT

[USB_Install.Services]
Include    = winusb.inf
Needs      = WINUSB.NT.Services
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName   = %WinUSB_SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{B6B8667C-EF86-4A0D-9B8E-3D5F1A9C4E21}"

[DestinationDirs]
DefaultDestDir = 12

[Strings]
ProviderName     = "UIFIPILL Lab"
ManufacturerName = "UIFIPILL Lab"
DeviceName       = "RT73 Raw USB (WinUSB)"
WinUSB_SvcDesc   = "WinUSB para RT73 raw"
