{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UIFIPILL",
  "mainBinaryName": "uifipill",
  "version": "1.0.27",
  "identifier": "com.local.uifipill",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UIFIPILL",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../tools/reaver.exe",
      "../tools/wash.exe",
      "../tools/libpcap.dll",
      "../tools/Packet.dll",
      "../tools/libwinpthread-1.dll",
      "../tools/libcrypto-3-x64.dll",
      "../tools/libssl-3-x64.dll",
      "../tools/aircrack-ng-win/*",
      "../tools/OpenCL/*",
      "../tools/modules/*",
      "../tools/charsets/*",
      "../tools/hashcat.exe",
      "../tools/hashcat.bin",
      "../tools/hashcat.hcstat2",
      "../tools/rules/*",
      "../tools/masks/*",
      "../driver_re/usb_tx/target/release/rt3070_deauth.exe",
      "../driver_re/usb_tx/target/release/rt73_rx.exe",
      "../driver_re/usb_tx/target/release/rt3070_chan_preflight.exe",
      "../driver_re/usb_tx/target/release/rt3070_probe.exe",
      "../driver_re/usb_tx/target/release/rt3070_init.exe",
      "../driver_re/usb_tx/target/release/rt3070_assoc.exe",
      "../driver_re/usb_tx/target/release/rt3070_scan.exe",
      "../driver_re/usb_tx/target/release/rt3070_sniff.exe",
      "../driver_re/usb_tx/rt2870.bin",
      "../scripts/reset_wifi.ps1"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
